               <code code="53413-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - QUESTIONS SECTION"/>
               <title>Questions or comments?</title>
               <text>
                  <paragraph>Call toll free: 1<content styleCode="bold">-877-753-3935</content> Monday-Friday 9AM-5PM EST</paragraph>
               </text>
               <effectiveTime value="20250502"/>
            </section>
         </component>
