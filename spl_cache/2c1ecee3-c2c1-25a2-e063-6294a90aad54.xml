            <section ID="id_link_dc68d5df-06d9-05f4-e053-2995a90a441c">
               <id root="2c1fae98-b8b9-6852-e063-6294a90a488c"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
