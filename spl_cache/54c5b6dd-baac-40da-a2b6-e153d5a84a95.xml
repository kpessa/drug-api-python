               <title>Inactive ingredients</title>
               <text>
                  <paragraph>D&amp;C red #33,  FD&amp;C blue #1, gelatin, hypromellose, isopropyl alcohol, polyethylene glycol, propylene glycol, potassium hydroxide, povidone, purified water, sorbitan, sorbitol, titanium dioxide</paragraph>
               </text>
               <effectiveTime value="20250507"/>
            </section>
         </component>
