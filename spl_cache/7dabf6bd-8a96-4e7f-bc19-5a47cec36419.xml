               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active Ingredient (in each capsule)</title>
               <text>
                  <paragraph>Cetirizine HCl 10 mg</paragraph>
               </text>
               <effectiveTime value="20250516"/>
            </section>
