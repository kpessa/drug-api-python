               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>Principal Display Panel</title>
               <text>
                  <paragraph>Compare to the active ingredient in Zyrtec®†</paragraph>
                  <paragraph>all day allergy</paragraph>
                  <paragraph>cetirizine HCI capsules 10 mg</paragraph>
                  <paragraph>Antihistamine </paragraph>
                  <paragraph>treats indoor &amp; outdoor allergies</paragraph>
                  <paragraph>12-hour relief of:</paragraph>
                  <list listType="unordered" styleCode="Disk">
                     <item>sneezing</item>
                     <item>runny nose</item>
                     <item>itchy, watery eyes</item>
                     <item>itchy throat or nose</item>
                  </list>
                  <paragraph>softgels**</paragraph>
                  <paragraph>(*Liquid-filled capsules) </paragraph>
                  <paragraph>†This product is not manufactured or distributed by McNeil Consumer Healthcare, distributor of Zyrtec®</paragraph>
                  <paragraph>
                     <content styleCode="bold">TAMPER EVIDENT: DO NOT USE IF PRINTED SAFETY SEAL UNDER CAP IS BROKEN OR MISSING.</content>
                  </paragraph>
                  <paragraph>
                     <content styleCode="bold">KEEP OUTER CARTON FOR COMPLETE WARNINGS AND PRODUCT INFORMATION.</content>
                  </paragraph>
                  <paragraph>Distributed by:</paragraph>
